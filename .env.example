# Copy to .env.production for Docker; configure these as Railway service variables.
# Never commit real values. Generate SECRET_KEY_BASE with: openssl rand -hex 64
SECRET_KEY_BASE=
# mysql:// is also accepted. Percent-encode special characters in URL credentials.
DATABASE_URL=mysql2://minimalist:replace-me@mysql:3306/minimalist
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEW_RELIC_AGENT_ENABLED=false
# Optional: Railway supplies PORT automatically.
PORT=3000
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info
