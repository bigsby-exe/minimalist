# Copy to .env on the Ubuntu server and fill in the blank values.
# Generate each secret separately: openssl rand -hex 32 (64 for SECRET_KEY_BASE).
MINIMALIST_IMAGE=ghcr.io/bigsby-exe/minimalist:latest
APP_PORT=3000
SECRET_KEY_BASE=
MYSQL_DATABASE=minimalist
MYSQL_USER=minimalist
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info

# Optional, only for a containerized proxy (Compose 2.24.4+):
# COMPOSE_FILE=compose.yaml:compose.proxy.yaml
# PROXY_NETWORK=your-existing-proxy-network
