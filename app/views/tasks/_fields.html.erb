<label class="tag-picker" title="Choose a tag">
  <span class="selected-emoji" aria-hidden="true"><%= @tags.find { |tag| tag.id == form.object.tag_id }&.emoji || '＋' %></span>
  <%= form.select :tag_id, @tags.map { |tag| ["#{tag.emoji} #{tag.name}", tag.id, { 'data-emoji': tag.emoji }] }, { include_blank: "Choose a tag" }, required: true, id: "#{prefix}-tag", 'aria-label': 'Tag' %>
</label>
<details class="date-picker">
  <summary aria-label="Choose due date" title="Choose due date"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18"/></svg></summary>
  <div class="date-popover">
    <label for="<%= prefix %>-date">Due date</label>
    <%= form.date_field :due_date, id: "#{prefix}-date" %>
    <button type="button" class="clear-date" data-date-input="<%= prefix %>-date">Clear date</button>
  </div>
</details>
