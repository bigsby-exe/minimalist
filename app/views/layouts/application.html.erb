<!DOCTYPE html>
<html lang="en">
<head>
  <title>minimalist</title>
  <meta name="description" content="Your tasks, organised by tag. Star what matters today.">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "workspace", media: "all" %>
  <%= javascript_include_tag "workspace", defer: true %>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="<%= user_signed_in? ? dashboard_path : root_path %>">minimalist<span>Make room for today.</span></a>
    <% if user_signed_in? %>
      <nav aria-label="Account"><%= link_to "Tasks", dashboard_path %><%= link_to "Profile", profile_path %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete %>
      </nav>
    <% end %>
  </header>
  <main>
    <% flash.each do |type, message| %>
      <p class="flash <%= type %>" role="status"><%= message %></p>
    <% end %>
    <%= yield %>
  </main>
</body>
</html>
