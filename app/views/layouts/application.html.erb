<!DOCTYPE html>
<html lang="en">
<head>
  <title>little steps</title>
  <meta name="description" content="Your tasks, organised by tag. Star what matters today.">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "workspace", media: "all" %>
  <%= javascript_include_tag "workspace", defer: true %>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="<%= user_signed_in? ? dashboard_path : root_path %>">little steps</a>
    <% if user_signed_in? %>
      <details class="account-menu">
        <summary aria-label="Account menu">
          <span class="avatar-fallback" aria-hidden="true"><%= (current_user.name.presence || current_user.email).first.upcase %></span>
          <% if current_user.image_url.present? %><%= image_tag current_user.image_url, class: 'avatar', alt: '', referrerpolicy: 'no-referrer' %><% end %>
        </summary>
        <nav aria-label="Account">
          <%= link_to "Profile", profile_path %>
          <% if phone_device %>
            <a href="intent://phone/settings#Intent;scheme=steps;package=dev.ecorp.steps;end">Phone and widgets</a>
            <a href="intent://phone/signout#Intent;scheme=steps;package=dev.ecorp.steps;end">Sign out</a>
          <% else %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete %>
          <% end %>
        </nav>
      </details>
    <% end %>
  </header>
  <main>
    <% flash.each do |type, message| %>
      <p class="flash <%= type %>" role="status"><%= message %></p>
    <% end %>
    <%= yield %>
  </main>
</body>
</html>
